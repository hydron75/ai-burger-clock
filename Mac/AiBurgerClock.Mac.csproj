<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos27.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>27.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiBurgerClock</RootNamespace>
    <AssemblyName>AI Burger Clock</AssemblyName>
    <ApplicationId>com.hydron75.aiburgerclock</ApplicationId>
    <ApplicationTitle>AI Burger Clock</ApplicationTitle>
    <Title>AI Burger Clock</Title>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <SelfContained>true</SelfContained>
    <!-- Apple SDK requires its trimmer pipeline even when preserving managed code. -->
    <TrimMode>copy</TrimMode>
    <EnableCodeSigning>true</EnableCodeSigning>
    <!-- Local ad-hoc signing only: no Apple account or distribution identity required. -->
    <CodesignKey>-</CodesignKey>
    <CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
    <EnableAppSandbox>false</EnableAppSandbox>
  </PropertyGroup>
  <Import Project="../Shared/SharedSources.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
