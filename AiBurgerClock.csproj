<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>AiBurgerClock</RootNamespace>
    <AssemblyName>AI Burger Clock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Preserve the Framework-era layout, font scaling and DPI behavior. -->
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Title>AI Burger Clock</Title>
    <Description>DST-aware AI Agent schedule, official status and local observations</Description>
    <Product>AI Burger Clock</Product>
    <Version>2.11.0</Version>
    <AssemblyVersion>2.11.0.0</AssemblyVersion>
    <FileVersion>2.11.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <!-- The native HWND host needs only the SDK's Core projection and x64 loader. -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <!-- Each OS host compiles the same canonical logic. Do not include the Mac
         entry point or the portable test runner in the Windows executable. -->
    <Compile Remove="Mac/**/*.cs;Shared.Tests/**/*.cs;artifacts/**/*.cs" />
  </ItemGroup>
  <Target Name="ExcludeWebView2SdkDocumentation" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'Microsoft.Web.WebView2.Core.xml'" />
    </ItemGroup>
  </Target>
</Project>
