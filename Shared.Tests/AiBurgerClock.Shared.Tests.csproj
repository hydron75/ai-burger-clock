<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiBurgerClock.Shared.Tests</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <Import Project="../Shared/SharedSources.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <Compile Include="../*Tests.cs"
             Exclude="../AutoStartTests.cs;../TrayPresentationTests.cs;../AccountQuotaClientTests.cs"
             Link="Tests/%(Filename)%(Extension)" />
    <Compile Include="../SharedTestSuite.cs" Link="Tests/SharedTestSuite.cs" />
  </ItemGroup>
</Project>
